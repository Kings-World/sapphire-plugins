{
	"name": "@kingsworld/sapphire-plugins",
	"author": "Seren_Modz 21 <seren@kings-world.net>",
	"repository": "github://Kings-World/sapphire-plugins",
	"license": "MIT",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "rimraf --glob \"packages/**/dist\" \"packages/**/.turbo\"",
		"lint": "eslint packages --fix",
		"format": "prettier --write .",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"check-update": "turbo run check-update"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@favware/npm-deprecate": "2.0.0",
		"@sapphire/eslint-config": "6.0.0",
		"@sapphire/framework": "catalog:",
		"@sapphire/pieces": "catalog:",
		"@sapphire/prettier-config": "3.0.0",
		"@sapphire/ts-config": "5.0.3",
		"@types/node": "catalog:",
		"@typescript-eslint/eslint-plugin": "8.73.0",
		"@typescript-eslint/parser": "8.73.0",
		"cz-conventional-changelog": "3.3.0",
		"discord.js": "14.28.1",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.7",
		"lint-staged": "17.6.1",
		"prettier": "3.10.1",
		"rimraf": "6.1.4",
		"tsdown": "catalog:",
		"turbo": "2.11.13",
		"typescript": "catalog:",
		"unplugin-replace": "0.9.1",
		"unrun": "0.3.1"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write",
		"*.{mjs,js,ts}": "eslint --fix --ext mjs,js,ts"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"prettier": "@sapphire/prettier-config",
	"packageManager": "yarn@4.18.1"
}
