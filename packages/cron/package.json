{
	"name": "@kingsworld/plugin-cron",
	"description": "A simple @sapphire/framework plugin that aims to make use of the croner package and allow users to make cron jobs within their Sapphire discord bot.",
	"version": "4.0.1",
	"author": "Seren_Modz 21 <seren@kings-world.net>",
	"license": "MIT",
	"type": "module",
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./register": {
			"types": "./dist/register.d.mts",
			"default": "./dist/register.mjs"
		}
	},
	"sideEffects": [
		"./dist/register.mjs"
	],
	"scripts": {
		"build": "tsdown --config-loader unrun",
		"typecheck": "tsc -b src",
		"prepack": "yarn build",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run"
	},
	"dependencies": {
		"croner": "^11.0.1"
	},
	"devDependencies": {
		"@favware/cliff-jumper": "6.1.0",
		"@sapphire/framework": "catalog:",
		"@sapphire/pieces": "catalog:",
		"@sentry/node": "11.14.0",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"homepage": "https://github.com/Kings-World/sapphire-plugins",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kings-World/sapphire-plugins.git",
		"directory": "packages/cron"
	},
	"keywords": [
		"sapphire",
		"plugin",
		"cron",
		"croner",
		"typescript",
		"ts",
		"discord",
		"yarn",
		"bot"
	],
	"bugs": {
		"url": "https://github.com/Kings-World/sapphire-plugins/issues",
		"email": "seren@kings-world.net"
	},
	"files": [
		"dist/",
		"!dist/.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=v24"
	}
}
